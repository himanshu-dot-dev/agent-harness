{
  "name": "agent-harness",
  "version": "1.0.0",
  "description": "Electron.js Agent Harness Application",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch src/main --exec electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "lint": "eslint src/**/*.js"
  },
  "keywords": ["electron", "desktop", "agent"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.1.0",
    "eslint": "^9.0.0"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "build": {
    "appId": "com.agent-harness.app",
    "productName": "Agent Harness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  }
}
